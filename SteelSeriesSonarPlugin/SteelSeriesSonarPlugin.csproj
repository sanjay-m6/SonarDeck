<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>SteelSeriesSonarPlugin</AssemblyName>
    <RootNamespace>SteelSeriesSonarPlugin</RootNamespace>
    <Version>1.2.0</Version>
    <AnalysisLevel>latest</AnalysisLevel>
    <UseAppHost>false</UseAppHost>
    <!-- Copy manifest + assets into build output so the plugin host can find them -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Macro Deck 3 SDK packages -->
    <PackageReference Include="MacroDeck.Plugin.Hosting" Version="3.0.0-preview.3" />
    <PackageReference Include="MacroDeck.Sdk" Version="3.0.0-preview.3" />
    <!-- Recommended: forward plugin logs into the MD3 host log stream -->
    <PackageReference Include="MacroDeck.Plugin.Serilog" Version="3.0.0-preview.3" />
    <!-- Compile-time analyzers catch common plugin mistakes -->
    <PackageReference Include="MacroDeck.Plugin.Analyzers" Version="3.0.0-preview.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Embed manifest.json into the output directory -->
  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\icon.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
